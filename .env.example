# ---- required ----
# From @BotFather → /newbot. Treat like a password.
BOT_TOKEN=123456789:replace-with-your-token
# One-time pairing secret. The first two people who send it to the bot become
# co-founders A and B; after that registration closes for good.
# Generate one with:  openssl rand -base64 24
SETUP_CODE=replace-with-a-long-random-secret

# ---- people (optional display names; otherwise Telegram first names are used) ----
PERSON_A_NAME=John
PERSON_B_NAME=Sami

# ---- storage ----
DATA_DIR=./data
# DATABASE_PATH=./data/tegbar.db

# ---- mode ----
# polling (default, no public URL needed) or webhook
BOT_MODE=polling
# Webhook mode only:
# WEBHOOK_URL=https://tegbar.example.com
# WEBHOOK_SECRET=replace-with-16-to-256-chars-A-Za-z0-9_-
PORT=8080
HOST=0.0.0.0

# ---- misc ----
TIMEZONE=Africa/Addis_Ababa
WORKSPACE_NAME=Tegbar
LOG_LEVEL=info
# ---- encrypted backups (strongly recommended) ----
# 16+ characters. Keep a copy OUTSIDE the server (password manager): without it no backup can be restored.
# Generate one with:  openssl rand -base64 32
# BACKUP_PASSPHRASE=
# BACKUP_KEEP=14
# BACKUP_TIME=02:30
# Send each backup to co-founder A on Telegram (files under 50 MB):
# BACKUP_TELEGRAM=on

# ---- HTTP API + Mini App dashboard (off by default) ----
# API_ENABLED=on
# Public HTTPS address of this server (Telegram only opens Mini Apps over HTTPS). Then: /features → Turn on miniapp
# PUBLIC_URL=https://tegbar.example.com
# Origin allowed to call the API from a browser (your Mini App URL). Leave unset for none.
# API_CORS_ORIGIN=https://tegbar.example.com
# Reject Telegram launch data older than this many seconds.
# API_INITDATA_MAX_AGE=86400

# Coloured buttons (Telegram Bot API "style" field). Set to off if your clients render oddly.
BUTTON_STYLES=on
