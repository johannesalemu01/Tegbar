# ---- required ----
# From @BotFather → /newbot. Treat like a password.
BOT_TOKEN=123456789:replace-with-your-token
# One-time pairing secret. The first two people who send it to the bot become
# co-founders A and B; after that registration closes for good.
# Generate one with:  openssl rand -base64 24
SETUP_CODE=replace-with-a-long-random-secret

# ---- people (optional display names; otherwise Telegram first names are used) ----
PERSON_A_NAME=John
PERSON_B_NAME=Sami

# ---- storage ----
DATA_DIR=./data
# DATABASE_PATH=./data/tegbar.db

# ---- mode ----
# polling (default, no public URL needed) or webhook
BOT_MODE=polling
# Webhook mode only:
# WEBHOOK_URL=https://tegbar.example.com
# WEBHOOK_SECRET=replace-with-16-to-256-chars-A-Za-z0-9_-
PORT=8080
HOST=0.0.0.0

# ---- misc ----
TIMEZONE=Africa/Addis_Ababa
WORKSPACE_NAME=Tegbar
LOG_LEVEL=info
# Coloured buttons (Telegram Bot API "style" field). Set to off if your clients render oddly.
BUTTON_STYLES=on
